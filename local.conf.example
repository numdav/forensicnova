# Sample DevStack local.conf for ForensicNova deployment
# Copy to /opt/stack/devstack/local.conf and adapt to your environment.

[[local|localrc]]
# ===== Credentials =====
ADMIN_PASSWORD=secret
DATABASE_PASSWORD=$ADMIN_PASSWORD
RABBIT_PASSWORD=$ADMIN_PASSWORD
SERVICE_PASSWORD=$ADMIN_PASSWORD

# ===== Networking (replace with your VM IP) =====
HOST_IP=192.168.x.x
SERVICE_HOST=$HOST_IP
MYSQL_HOST=$SERVICE_HOST
RABBIT_HOST=$SERVICE_HOST
GLANCE_HOSTPORT=$SERVICE_HOST:9292

# ===== Cinder off, Swift on (forensic artifacts live in object storage) =====
disable_service cinder c-api c-sch c-vol
enable_service s-proxy s-object s-container s-account
SWIFT_HASH=change_me_to_a_random_string
SWIFT_REPLICAS=1
SWIFT_DATA_DIR=/opt/stack/data/swift

# Swift loopback disk size.
#
# DevStack defaults to a small loopback (about 6 GB) which is sufficient for
# the CirrOS test images that DevStack ships, but NOT for forensic RAM dumps:
# a single dump of an 8 GiB guest splits into 2 SLO segments of 4 GiB each
# plus a manifest, requiring roughly 12 GiB of object-store space just for
# one acquisition. To allow multiple acquisitions and leave headroom for the
# Swift internals (account/container databases, partition rebalance scratch),
# we size the loopback at 30 GB.
#
# Raise this value if you plan to acquire larger guests or keep many
# acquisitions in the evidence locker before re-stacking.
SWIFT_LOOPBACK_DISK_SIZE=30G

# ===== KVM with nested virtualization =====
LIBVIRT_TYPE=kvm

# ===== Logging =====
LOGFILE=/opt/stack/logs/stack.sh.log
LOGDAYS=2
VERBOSE=True
LOG_COLOR=True

# ===== ForensicNova plugin =====
enable_plugin forensicnova https://github.com/numdav/forensicnova main

# DFIR User credentials (REQUIRED)
FORENSICNOVA_DFIR_PASSWORD=REPLACE_ME_WITH_A_STRONG_PASSWORD
