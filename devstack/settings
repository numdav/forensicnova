# ForensicNova DevStack plugin — settings
# Variables are overridable from local.conf.
# Pattern: ${VAR:-default} means "keep VAR if already set, otherwise use default".

# --- Plugin layout ---
FORENSICNOVA_DIR=${FORENSICNOVA_DIR:-$DEST/forensicnova}
FORENSICNOVA_PORT=${FORENSICNOVA_PORT:-5234}
FORENSICNOVA_BIND_HOST=${FORENSICNOVA_BIND_HOST:-0.0.0.0}

# --- Keystone identity artifacts ---
FORENSICNOVA_ROLE=${FORENSICNOVA_ROLE:-forensic_analyst}
FORENSICNOVA_PROJECT=${FORENSICNOVA_PROJECT:-forensics}
FORENSICNOVA_PROJECT_DESCRIPTION=${FORENSICNOVA_PROJECT_DESCRIPTION:-ForensicNova DFIR artifacts and memory acquisition}
FORENSICNOVA_DFIR_USER=${FORENSICNOVA_DFIR_USER:-dfir-tester}
FORENSICNOVA_DFIR_PASSWORD=${FORENSICNOVA_DFIR_PASSWORD:-}

# --- Keystone service catalog (Feature 3.5) ---
# ForensicNova registers itself as a first-class OpenStack service so that
# clients (and the Horizon dashboard in Feature 4) can discover the API
# endpoint through the Keystone catalog instead of hard-coding host:port.
#   - SERVICE_NAME : human-readable name shown by 'openstack service list'
#   - SERVICE_TYPE : the catalog 'type' clients query for (also 'dfir')
#   - The public URL is built at runtime in plugin.sh from HOST_IP + PORT,
#     because HOST_IP is not yet known when this settings file is sourced.
FORENSICNOVA_SERVICE_NAME=${FORENSICNOVA_SERVICE_NAME:-dfir}
FORENSICNOVA_SERVICE_TYPE=${FORENSICNOVA_SERVICE_TYPE:-dfir}
FORENSICNOVA_SERVICE_DESCRIPTION=${FORENSICNOVA_SERVICE_DESCRIPTION:-ForensicNova DFIR memory acquisition API}

# --- Swift storage ---
FORENSICNOVA_SWIFT_CONTAINER=${FORENSICNOVA_SWIFT_CONTAINER:-forensics}

# Feature 2 — SLO segment size in BYTES.
#   Default 4 GiB = 4 * 1024^3 = 4294967296.
#   Files at or above this size are uploaded via Swift Static Large Object,
#   split into segments of this exact size (last segment may be smaller).
#   Override in local.conf for testing with smaller segments, e.g.
#     FORENSICNOVA_SLO_SEGMENT_SIZE=536870912    # 512 MiB
FORENSICNOVA_SLO_SEGMENT_SIZE=${FORENSICNOVA_SLO_SEGMENT_SIZE:-4294967296}

# --- Runtime filesystem layout (on the host) ---
FORENSICNOVA_WORK_DIR=${FORENSICNOVA_WORK_DIR:-/var/lib/forensicnova}
FORENSICNOVA_LOG_DIR=${FORENSICNOVA_LOG_DIR:-/var/log/forensicnova}
FORENSICNOVA_CONF_DIR=${FORENSICNOVA_CONF_DIR:-/etc/forensicnova}
FORENSICNOVA_CONF_FILE=${FORENSICNOVA_CONF_FILE:-$FORENSICNOVA_CONF_DIR/forensicnova.conf}

# Feature 3.5 — directory where the async JobManager persists one JSON
# file per acquisition job. Lives under WORK_DIR so it shares the same
# ownership (stack:stack) and is wiped by clean.
FORENSICNOVA_JOBS_DIR=${FORENSICNOVA_JOBS_DIR:-$FORENSICNOVA_WORK_DIR/jobs}

# --- Generated openrc for testing as dfir-tester ---
FORENSICNOVA_OPENRC=${FORENSICNOVA_OPENRC:-$DEST/devstack/openrc-dfir}

# --- Feature 4 — Horizon dashboard plugin ---
# Monorepo: the Horizon dashboard package (forensicnova_dashboard/) lives
# at the root of the same git repo as the backend (app/). So this directory
# resolves to the same path as FORENSICNOVA_DIR — both setup.cfg and
# pip install -e operate from there.
FORENSICNOVA_DASHBOARD_DIR=${FORENSICNOVA_DASHBOARD_DIR:-$FORENSICNOVA_DIR}

# Where Horizon discovers third-party panel registration files
# (the _9NNN_*.py drop-ins). Standard path on DevStack-deployed Horizon.
HORIZON_LOCAL_ENABLED_DIR=${HORIZON_LOCAL_ENABLED_DIR:-$DEST/horizon/openstack_dashboard/local/enabled}

# --- DevStack service registration ---
# Two service flags from a single plugin: each branch of plugin.sh
# guards itself with `is_service_enabled`, so dashboards can be turned
# off independently from the backend via `disable_service` in local.conf.
enable_service forensicnova
enable_service forensicnova-dashboard

# =============================================================================
# Analyzer service (forensicnova-analyzer) — Volatility 3 + future MISP/YARA
# =============================================================================
#
# Second Flask backend of the project, separate from the acquisition
# backend. Same git repo (monorepo), same enable_plugin entry, but:
#   - dedicated venv (.venv-analyzer)
#   - dedicated systemd unit (devstack@forensicnova-analyzer.service)
#   - dedicated TCP port (5235)
#   - dedicated Keystone service (dfir-analyzer)
#
# Architectural rationale: crash isolation of Volatility scans +
# independent lifecycle (analyzer restart does not interrupt in-flight
# acquisitions).

# --- Analyzer plugin layout ---
FORENSICNOVA_ANALYZER_DIR=${FORENSICNOVA_ANALYZER_DIR:-$FORENSICNOVA_DIR}
FORENSICNOVA_ANALYZER_PORT=${FORENSICNOVA_ANALYZER_PORT:-5235}
FORENSICNOVA_ANALYZER_BIND_HOST=${FORENSICNOVA_ANALYZER_BIND_HOST:-0.0.0.0}

# --- Analyzer Keystone service catalog ---
# Separate type 'dfir-analyzer' to distinguish from the acquisition
# backend 'dfir'. Lets the dashboard plugin (future) perform catalog
# discovery specifically for the analyzer.
FORENSICNOVA_ANALYZER_SERVICE_NAME=${FORENSICNOVA_ANALYZER_SERVICE_NAME:-dfir-analyzer}
FORENSICNOVA_ANALYZER_SERVICE_TYPE=${FORENSICNOVA_ANALYZER_SERVICE_TYPE:-dfir-analyzer}
FORENSICNOVA_ANALYZER_SERVICE_DESCRIPTION=${FORENSICNOVA_ANALYZER_SERVICE_DESCRIPTION:-ForensicNova DFIR memory analyzer API (Volatility 3)}

# --- Runtime filesystem layout (host) ---
FORENSICNOVA_ANALYZER_WORK_DIR=${FORENSICNOVA_ANALYZER_WORK_DIR:-/var/lib/forensicnova-analyzer}
FORENSICNOVA_ANALYZER_JOBS_DIR=${FORENSICNOVA_ANALYZER_JOBS_DIR:-$FORENSICNOVA_ANALYZER_WORK_DIR/jobs}
FORENSICNOVA_ANALYZER_CONF_FILE=${FORENSICNOVA_ANALYZER_CONF_FILE:-$FORENSICNOVA_CONF_DIR/forensicnova-analyzer.conf}
FORENSICNOVA_ANALYZER_LOG_FILE=${FORENSICNOVA_ANALYZER_LOG_FILE:-$FORENSICNOVA_LOG_DIR/analyzer.log}

# Volatility 3 symbol cache directory (XDG_CACHE_HOME for the service).
# Dedicated path under WORK_DIR so it is wiped by `clean` and isolated
# from the user cache. PDB files from the Microsoft Symbol Server are
# downloaded and converted here on first run.
FORENSICNOVA_ANALYZER_VOL3_CACHE=${FORENSICNOVA_ANALYZER_VOL3_CACHE:-$FORENSICNOVA_ANALYZER_WORK_DIR/vol3-cache}

# --- DevStack service registration ---
# Additional service flag for the analyzer backend. Disable from
# local.conf with `disable_service forensicnova-analyzer`.
enable_service forensicnova-analyzer
